<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Medieval_Internship.Models"
             x:Class="Medieval_Internship.Views.DashboardPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">

        <!-- ================= TOP APP BAR ================= -->
        <Border Grid.Row="0"
                BackgroundColor="#0F172A"
                Stroke="Transparent"
                Padding="20,14"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                <!-- Left: Brand & Role Pill -->
                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 8"
                            BackgroundColor="#1E293B"
                            Stroke="#334155"
                            StrokeThickness="1"
                            Padding="6"
                            HeightRequest="36"
                            WidthRequest="36">
                        <Image Source="logo_smk.png" Aspect="AspectFit"/>
                    </Border>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="PKL MONITOR"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   VerticalOptions="Center"/>
                            <Border x:Name="RoleHeaderBadge"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Padding="8,2"
                                    BackgroundColor="#10B981"
                                    VerticalOptions="Center">
                                <Label x:Name="RoleBadgeLabel"
                                       Text="Siswa"
                                       TextColor="White"
                                       FontSize="11"
                                       FontAttributes="Bold"/>
                            </Border>
                        </HorizontalStackLayout>
                        <Label x:Name="HeaderOrgLabel"
                               Text="SMK Negeri 1 Jakarta • Tahun Ajaran 2026/2027"
                               TextColor="#94A3B8"
                               FontSize="11"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Right: User Avatar & Logout Button -->
                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 18"
                            HeightRequest="36"
                            WidthRequest="36"
                            Stroke="#475569"
                            StrokeThickness="1"
                            x:Name="AvatarBorder"
                            BackgroundColor="#2563EB">
                        <Label x:Name="AvatarInitialsLabel"
                               Text="RP"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="13"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label x:Name="UserNameLabel"
                               Text="Rizky Pratama"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="13"/>
                        <Label x:Name="UserSubLabel"
                               Text="XII RPL 1"
                               TextColor="#94A3B8"
                               FontSize="11"/>
                    </VerticalStackLayout>

                    <Button Text="Keluar"
                            Clicked="OnLogoutClicked"
                            BackgroundColor="#334155"
                            TextColor="#F1F5F9"
                            FontSize="12"
                            HeightRequest="34"
                            Padding="12,0"
                            CornerRadius="8"
                            Margin="8,0,0,0"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- ================= MAIN SCROLLABLE CONTENT ================= -->
        <ScrollView Grid.Row="1" Orientation="Vertical">
            <VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="1200" HorizontalOptions="Center">


                <!-- 2. WELCOME HERO CARD -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="#1E3A5F"
                        Stroke="Transparent"
                        Padding="24"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label x:Name="HeroRoleSubtitle"
                                       Text="Siswa Magang (Intern) • PT Telkom Indonesia"
                                       TextColor="#93C5FD"
                                       FontSize="12"
                                       FontAttributes="Bold"/>
                                <Label x:Name="HeroWelcomeTitle"
                                       Text="Semangat Pagi, Rizky Pratama! 🚀"
                                       TextColor="White"
                                       FontSize="22"
                                       FontAttributes="Bold"/>
                                <Label x:Name="HeroWelcomeDesc"
                                       Text="Hari ke-45 dari 90 hari PKL. Presensi masuk dan laporkan aktivitas harianmu ke sistem."
                                       TextColor="#E2E8F0"
                                       FontSize="13"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 24"
                                    BackgroundColor="#2563EB"
                                    Stroke="#3B82F6"
                                    StrokeThickness="1"
                                    HeightRequest="48"
                                    WidthRequest="48"
                                    VerticalOptions="Start"
                                    HorizontalOptions="End">
                                <Label x:Name="HeroIconLabel"
                                       Text="🚀"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- Progress Bar Section (Visible for Siswa/Operator/Monitor) -->
                        <VerticalStackLayout x:Name="ProgressSection" Spacing="6" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label x:Name="ProgressTitleLabel"
                                       Text="Progres Periode Magang (45 / 90 Hari)"
                                       TextColor="#BAE6FD"
                                       FontSize="12"
                                       FontAttributes="Bold"/>
                                <Label Grid.Column="1"
                                       x:Name="ProgressTextLabel"
                                       Text="50% Selesai"
                                       TextColor="White"
                                       FontSize="12"
                                       FontAttributes="Bold"/>
                            </Grid>
                            <ProgressBar x:Name="HeroProgressBar"
                                         Progress="0.5"
                                         ProgressColor="#10B981"
                                         BackgroundColor="#334155"
                                         HeightRequest="8"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. STAT CARDS (4 METRICS) -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Statistik &amp; Indikator Utama"
                           TextColor="#1E293B"
                           FontAttributes="Bold"
                           FontSize="16"/>

                    <FlexLayout x:Name="StatCardsContainer"
                                Wrap="Wrap"
                                JustifyContent="SpaceBetween"
                                AlignItems="Stretch">
                        <!-- Populated dynamically via C# code for smooth card rendering -->
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- 4. QUICK ACTIONS SECTION -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Aksi Cepat &amp; Menu Utama"
                           TextColor="#1E293B"
                           FontAttributes="Bold"
                           FontSize="16"/>

                    <FlexLayout x:Name="QuickActionsContainer"
                                Wrap="Wrap"
                                JustifyContent="SpaceBetween"
                                AlignItems="Stretch">
                        <!-- Populated dynamically via C# code for smooth card rendering -->
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- 5. MAIN CONTENT SPECIFIC TO CURRENT ROLE -->
                <!-- SECTION A: STUDENTS LIST (For Guru / Pembimbing Industri) -->
                <VerticalStackLayout x:Name="StudentsSection" Spacing="10" IsVisible="False">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="StudentsSectionTitle"
                               Text="Daftar Siswa Bimbingan"
                               TextColor="#1E293B"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Label Grid.Column="1"
                               Text="Lihat Semua Siswa →"
                               TextColor="#2563EB"
                               FontSize="12"
                               FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnViewAllStudentsTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout x:Name="StudentsListContainer" Spacing="10">
                        <!-- Populated dynamically via code -->
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- SECTION B: JOURNALS LIST (For Siswa / Guru / Industri) -->
                <VerticalStackLayout x:Name="JournalsSection" Spacing="10" IsVisible="False">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="JournalsSectionTitle"
                               Text="Jurnal Aktivitas &amp; Log Harian"
                               TextColor="#1E293B"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Button Grid.Column="1"
                                Text="+ Tambah Jurnal"
                                Clicked="OnAddJournalClicked"
                                HeightRequest="32"
                                Padding="12,0"
                                FontSize="12"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="8"/>
                    </Grid>

                    <VerticalStackLayout x:Name="JournalsListContainer" Spacing="10">
                        <!-- Populated dynamically via code -->
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- SECTION C: DOCUMENTS LIST (For Operator) -->
                <VerticalStackLayout x:Name="DocumentsSection" Spacing="10" IsVisible="False">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Berkas &amp; Dokumen Resmi PKL"
                               TextColor="#1E293B"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Button Grid.Column="1"
                                Text="+ Terbitkan Dokumen"
                                Clicked="OnAddDocumentClicked"
                                HeightRequest="32"
                                Padding="12,0"
                                FontSize="12"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="8"/>
                    </Grid>

                    <VerticalStackLayout x:Name="DocumentsListContainer" Spacing="10">
                        <!-- Populated dynamically via code -->
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- SECTION D: ACTIVITY & AUDIT LOG -->
                <VerticalStackLayout x:Name="ActivitiesSection" Spacing="10" IsVisible="False">
                    <Label Text="Riwayat Aktivitas &amp; Informasi Terkini"
                           TextColor="#1E293B"
                           FontAttributes="Bold"
                           FontSize="16"/>

                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="16">
                        <VerticalStackLayout x:Name="ActivitiesListContainer" Spacing="14">
                            <!-- Populated dynamically via code -->
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 6. FOOTER -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="#F1F5F9"
                        Stroke="Transparent"
                        Padding="16"
                        Margin="0,10,0,20">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Aplikasi PKL Monitor Vokasi • Versi 2.4.0 Build 2026"
                               TextColor="#64748B"
                               FontSize="11"
                               HorizontalOptions="Center"/>
                        <Label Text="Direktorat Sekolah Menengah Kejuruan • Kementerian Pendidikan &amp; Kebudayaan"
                               TextColor="#94A3B8"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
