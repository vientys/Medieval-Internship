<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Medieval_Internship.Views.Modules.PenempatanPklModulePage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                BackgroundColor="#0F172A"
                Padding="16,12"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0"
                        Text="← Kembali"
                        Clicked="OnBackClicked"
                        BackgroundColor="#1E293B"
                        TextColor="White"
                        FontSize="12"
                        HeightRequest="36"
                        Padding="12,0"
                        CornerRadius="8"/>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Text="MODUL PENEMPATAN &amp; PENUGASAN PKL"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalOptions="Center"/>
                    <Label x:Name="UserRoleSubtitle"
                           Text="Penetapan DUDI, Penugasan Mentor Internal/Eksternal &amp; Periode PKL"
                           TextColor="#94A3B8"
                           FontSize="11"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#D97706"
                        Padding="10,4"
                        StrokeThickness="0">
                    <Label Text="🤝 Penempatan"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                Padding="16,8">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button x:Name="TabPlottingBtn"
                        Text="🤝 Plotting Penempatan"
                        Clicked="OnTabPlottingClicked"
                        BackgroundColor="#1E3A5F"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="36"
                        CornerRadius="8"/>
                <Button x:Name="TabPeriodsBtn"
                        Text="📅 Periode &amp; Gelombang"
                        Clicked="OnTabPeriodsClicked"
                        BackgroundColor="#F1F5F9"
                        TextColor="#475569"
                        FontSize="12"
                        HeightRequest="36"
                        CornerRadius="8"/>
                <Button x:Name="TabTrackingBtn"
                        Text="📊 Tracking Perkembangan"
                        Clicked="OnTabTrackingClicked"
                        BackgroundColor="#F1F5F9"
                        TextColor="#475569"
                        FontSize="12"
                        HeightRequest="36"
                        CornerRadius="8"/>
            </HorizontalStackLayout>
        </Border>

        <!-- MAIN SCROLL -->
        <ScrollView Grid.Row="2" Orientation="Vertical">
            <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="950" HorizontalOptions="Center">

                <!-- STATUS BANNER -->
                <Border x:Name="StatusBanner"
                        IsVisible="False"
                        StrokeShape="RoundRectangle 10"
                        Padding="14,10"
                        BackgroundColor="#ECFDF5"
                        Stroke="#6EE7B7">
                    <Label x:Name="StatusLabel" TextColor="#065F46" FontSize="13"/>
                </Border>

                <!-- ================= TAB 1: PLOTTING PENEMPATAN ================= -->
                <VerticalStackLayout x:Name="SectionPlotting" Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Penetapan Siswa ke Perusahaan &amp; Penugasan Mentor"
                               TextColor="#0F172A"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#FEF3C7"
                                Padding="10,4"
                                StrokeThickness="0">
                            <Label Text="172 / 185 Siswa Terplotting"
                                   TextColor="#92400E"
                                   FontSize="11"
                                   FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <VerticalStackLayout x:Name="PlottingContainer" Spacing="10">
                        <!-- Populated dynamically -->
                    </VerticalStackLayout>
                </VerticalStackLayout>


                <!-- ================= TAB 2: PERIODE & GELOMBANG ================= -->
                <VerticalStackLayout x:Name="SectionPeriods" Spacing="16" IsVisible="False">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Konfigurasi Periode &amp; Gelombang Pelaksanaan PKL"
                               TextColor="#0F172A"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Button Grid.Column="1"
                                Text="+ Tambah Periode"
                                Clicked="OnAddPeriodPromptClicked"
                                BackgroundColor="#059669"
                                TextColor="White"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="12,0"
                                CornerRadius="8"/>
                    </Grid>

                    <VerticalStackLayout x:Name="PeriodsContainer" Spacing="12">
                        <!-- Populated dynamically -->
                    </VerticalStackLayout>
                </VerticalStackLayout>


                <!-- ================= TAB 3: TRACKING PERKEMBANGAN ================= -->
                <VerticalStackLayout x:Name="SectionTracking" Spacing="16" IsVisible="False">
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="#1E3A5F"
                            Padding="20"
                            StrokeThickness="0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="PEMANTAUAN TERPADU PERKEMBANGAN SISWA PKL"
                                   TextColor="#93C5FD"
                                   FontSize="11"
                                   FontAttributes="Bold"/>
                            <Label Text="Progress Pelaksanaan Hari ke-45 dari 90 Hari (50%)"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                            <Label Text="Integrasi data presensi harian, logbook kegiatan, kunjungan supervisi guru, dan review mentor industri secara terpusat."
                                   TextColor="#E2E8F0"
                                   FontSize="12"/>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout x:Name="TrackingContainer" Spacing="10">
                        <!-- Populated dynamically -->
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
