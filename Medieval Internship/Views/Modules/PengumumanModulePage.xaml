<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Medieval_Internship.Views.Modules.PengumumanModulePage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                BackgroundColor="#0F172A"
                Padding="16,12"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0"
                        Text="← Kembali"
                        Clicked="OnBackClicked"
                        BackgroundColor="#1E293B"
                        TextColor="White"
                        FontSize="12"
                        HeightRequest="36"
                        Padding="12,0"
                        CornerRadius="8"/>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Text="MODUL INFORMASI &amp; PENGUMUMAN"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalOptions="Center"/>
                    <Label x:Name="UserRoleSubtitle"
                           Text="Pemberitahuan Resmi Sekolah &amp; Hubungan Industri Berbasis Peran"
                           TextColor="#94A3B8"
                           FontSize="11"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#0D9488"
                        Padding="10,4"
                        StrokeThickness="0">
                    <Label Text="📢 Pengumuman"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                Padding="16,8">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button x:Name="TabListBtn"
                        Text="📢 Daftar Pengumuman"
                        Clicked="OnTabListClicked"
                        BackgroundColor="#1E3A5F"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="36"
                        CornerRadius="8"/>
                <Button x:Name="TabCreateBtn"
                        Text="✍️ Terbitkan Pengumuman"
                        Clicked="OnTabCreateClicked"
                        BackgroundColor="#F1F5F9"
                        TextColor="#475569"
                        FontSize="12"
                        HeightRequest="36"
                        CornerRadius="8"/>
            </HorizontalStackLayout>
        </Border>

        <!-- MAIN SCROLL -->
        <ScrollView Grid.Row="2" Orientation="Vertical">
            <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="900" HorizontalOptions="Center">

                <!-- STATUS BANNER -->
                <Border x:Name="StatusBanner"
                        IsVisible="False"
                        StrokeShape="RoundRectangle 10"
                        Padding="14,10"
                        BackgroundColor="#ECFDF5"
                        Stroke="#6EE7B7">
                    <Label x:Name="StatusLabel" TextColor="#065F46" FontSize="13"/>
                </Border>

                <!-- ================= TAB 1: DAFTAR PENGUMUMAN ================= -->
                <VerticalStackLayout x:Name="SectionList" Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Pemberitahuan Resmi PKL (Sesuai Hak Akses)"
                               TextColor="#0F172A"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Button x:Name="HeaderCreateBtn"
                                Grid.Column="1"
                                Text="+ Buat Pengumuman"
                                Clicked="OnTabCreateClicked"
                                BackgroundColor="#0D9488"
                                TextColor="White"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="12,0"
                                CornerRadius="8"/>
                    </Grid>

                    <VerticalStackLayout x:Name="AnnouncementsContainer" Spacing="12">
                        <!-- Dynamic announcements -->
                    </VerticalStackLayout>
                </VerticalStackLayout>


                <!-- ================= TAB 2: BUAT PENGUMUMAN ================= -->
                <VerticalStackLayout x:Name="SectionCreate" Spacing="16" IsVisible="False">
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="20">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Publikasikan Pengumuman / Surat Edaran Resmi"
                                   TextColor="#0F172A"
                                   FontAttributes="Bold"
                                   FontSize="15"/>

                            <!-- Judul Pengumuman -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Judul Pengumuman *"
                                       TextColor="#334155"
                                       FontSize="12"
                                       FontAttributes="Bold"/>
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#CBD5E1"
                                        Padding="12,0">
                                    <Entry x:Name="AnnTitleEntry"
                                           Placeholder="Contoh: Jadwal Pembekalan dan Pelepasan PKL Gelombang 1"
                                           TextColor="#0F172A"
                                           FontSize="13"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Sasaran Peran & Prioritas -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Sasaran Penerima (RBAC) *"
                                           TextColor="#334155"
                                           FontSize="12"
                                           FontAttributes="Bold"/>
                                    <Border StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#F8FAFC"
                                            Stroke="#CBD5E1"
                                            Padding="10,0">
                                        <Picker x:Name="AudiencePicker"
                                                Title="Pilih Sasaran"
                                                TextColor="#0F172A">
                                            <Picker.Items>
                                                <x:String>Semua (Seluruh Pengguna)</x:String>
                                                <x:String>Siswa</x:String>
                                                <x:String>Guru Pendamping</x:String>
                                                <x:String>Pembimbing Industri</x:String>
                                                <x:String>Monitor</x:String>
                                            </Picker.Items>
                                        </Picker>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Tingkat Prioritas *"
                                           TextColor="#334155"
                                           FontSize="12"
                                           FontAttributes="Bold"/>
                                    <Border StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#F8FAFC"
                                            Stroke="#CBD5E1"
                                            Padding="10,0">
                                        <Picker x:Name="PriorityPicker"
                                                Title="Pilih Prioritas"
                                                TextColor="#0F172A">
                                            <Picker.Items>
                                                <x:String>Penting</x:String>
                                                <x:String>Pengingat</x:String>
                                                <x:String>Info Biasa</x:String>
                                                <x:String>Mendesak</x:String>
                                            </Picker.Items>
                                        </Picker>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Isi Pengumuman -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Isi Pesan / Instruksi Pengumuman *"
                                       TextColor="#334155"
                                       FontSize="12"
                                       FontAttributes="Bold"/>
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#CBD5E1"
                                        Padding="12,8">
                                    <Editor x:Name="AnnContentEditor"
                                            Placeholder="Tuliskan isi pengumuman secara rinci..."
                                            TextColor="#0F172A"
                                            HeightRequest="100"
                                            FontSize="13"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Lampiran Dokumen -->
                            <Border StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#F0FDFA"
                                    Stroke="#99F6E4"
                                    Padding="14">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Label Grid.Column="0" Text="📄" FontSize="22" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Lampiran Berkas Resmi (PDF / Docx)"
                                               TextColor="#0F766E"
                                               FontSize="12"
                                               FontAttributes="Bold"/>
                                        <Label x:Name="AttachmentProofLabel"
                                               Text="Surat_Edaran_Resmi_Hubin_2026.pdf (1.1 MB)"
                                               TextColor="#0D9488"
                                               FontSize="11"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2"
                                            Text="Pilih File"
                                            Clicked="OnChooseAttachmentClicked"
                                            BackgroundColor="#0D9488"
                                            TextColor="White"
                                            FontSize="11"
                                            HeightRequest="32"
                                            Padding="10,0"
                                            CornerRadius="6"/>
                                </Grid>
                            </Border>

                            <!-- Pin Option -->
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <CheckBox x:Name="PinCheck" IsChecked="True"/>
                                <Label Text="Sematkan (Pin) di bagian atas pengumuman"
                                       TextColor="#334155"
                                       FontSize="12"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Submit Button -->
                            <Button Text="Terbitkan Pengumuman Sekarang 📢"
                                    Clicked="OnSubmitAnnouncementClicked"
                                    BackgroundColor="#0D9488"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HeightRequest="46"
                                    CornerRadius="10"
                                    Margin="0,8,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
